# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/bookingassistant

# Server port (optional, defaults to 5000)
PORT=5000

# OpenAI API key, used by POST /api/chat to extract booking details
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the model used for extraction (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
